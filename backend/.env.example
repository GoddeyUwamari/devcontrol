# Backend environment example for `npm run dev` against your own Postgres.
# Copy to backend/.env and adjust. Every value here is a fake local
# placeholder; never put a real key in this file.
#
# For a fully local, zero-external-call stack use `npm run dev:local`
# instead: it generates its own settings and never reads backend/.env.

NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3010

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=platform_portal
DB_USER=postgres
DB_PASSWORD=postgres

# --- Required secrets (local placeholders) --------------------------------
# JWT_SECRET: at least 32 characters. Generate a real one: openssl rand -base64 32
JWT_SECRET=local-dev-jwt-secret-not-a-secret-placeholder
# ENCRYPTION_KEY: exactly 32 characters. Generate a real one: openssl rand -hex 16
ENCRYPTION_KEY=local-dev-encryption-key-32chars

# --- Integrations: leave empty to disable ---------------------------------
# Stripe billing: leave empty to disable (setting STRIPE_SECRET_KEY requires all of the below)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret: leave empty to disable
STRIPE_WEBHOOK_SECRET=
# Stripe recurring price IDs: leave empty to disable
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Anthropic (AI features): leave empty to disable
ANTHROPIC_API_KEY=

# Resend (transactional email): leave empty to disable
RESEND_API_KEY=
# Sender address for email: leave empty to use the built-in default
EMAIL_FROM=

# SMTP (scheduled reports): leave empty to disable
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# GitHub webhook signing secret and target org: leave empty to disable
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_ORG_ID=

# --- AWS --------------------------------------------------------------------
# The platform's 12-digit AWS account ID (required in production only): leave empty to disable Connect AWS
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Prometheus for the observability pages: leave empty to use http://localhost:9090
PROMETHEUS_URL=
